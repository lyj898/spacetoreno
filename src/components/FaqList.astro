---
interface Props {
  faqs: { q: string; a: string }[];
}
const { faqs } = Astro.props;
---
{faqs.length > 0 && (
  <section class="faq" aria-labelledby="questions">
    <h2 id="questions">Questions people ask</h2>
    {faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>
)}
