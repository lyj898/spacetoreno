---
interface Props {
  href: string;
  title: string;
  summary: string;
  kicker?: string;
  step?: number;
  /** Illustration in public/illo/ (no extension). Decorative here: the title says what the guide is. */
  illo?: string;
}
const { href, title, summary, kicker, step, illo } = Astro.props;
---
<a class="guide-card" href={href}>
  {illo && <img class="guide-card-illo" src={`/illo/${illo}.svg`} alt="" width="160" height="110" loading="lazy" decoding="async" />}
  <div class="guide-card-body">
    {(kicker || step !== undefined) && (
      <span class="guide-kicker">
        {step !== undefined && <span class="guide-step">{`Step ${step}`}</span>}
        {kicker}
      </span>
    )}
    <h3>{title}</h3>
    <p>{summary}</p>
    <span class="guide-read">Read the guide →</span>
  </div>
</a>
