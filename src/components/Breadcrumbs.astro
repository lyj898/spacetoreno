---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  {items.map((item, i) => (
    <>
      {item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
      {i < items.length - 1 && <span class="sep" aria-hidden="true">/</span>}
    </>
  ))}
</nav>
